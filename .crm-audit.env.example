# Capability file for the local CRM auditor only.
# Copy to `.crm-audit.env`, keep it out of Git, set mode 0600, and provision
# the values through the approved operator flow. Never reuse the service-role key.

CRM_AUDIT_SUPABASE_URL=https://your-project.supabase.co
CRM_AUDIT_API_KEY=your-project-anon-jwt
CRM_AUDIT_ACCESS_TOKEN=your-account-bound-gama-crm-auditor-jwt
CRM_AUDIT_ACCOUNT_ID=your-account-uuid
CRM_AUDIT_REFERENCE_KEY=your-random-32-byte-base64url-key

# Required only by the manually approved reference resolver.
CRM_AUDIT_UI_ORIGIN=https://crm.example.com

# Optional exact cross-check. If present, it must match CRM_AUDIT_SUPABASE_URL.
# CRM_AUDIT_SUPABASE_ORIGIN=https://your-project.supabase.co

# Optional alert thresholds. These affect classification only; they never write CRM data.
# CRM_AUDIT_HISTORY_DAYS=90
# CRM_AUDIT_INCIDENT_LOOKBACK_DAYS=30
# CRM_AUDIT_RESPONSE_SLA_MINUTES=30
# CRM_AUDIT_STALE_SENT_MINUTES=120
# CRM_AUDIT_PENDING_GRACE_MINUTES=15
